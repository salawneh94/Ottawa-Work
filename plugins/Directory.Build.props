<Project>
  <!--
    Shared build settings for every project under /plugins/src.
    Default target is Revit 2025 (.NET 8). Revit 2026 is also built (same
    .NET 8 runtime generation as 2025) — pass -p:RevitVersion=2026 on the
    dotnet build/restore command line to target it (see the CI matrix in
    .github/workflows/build-plugins.yml, which builds both). To build
    against an older Revit (2022-2024, which run on .NET Framework 4.8),
    pass -p:RevitVersion=2024 (etc.) instead, or override
    RevitVersion/TargetFramework in a specific project.

    Revit API references come from the community-maintained Nice3point.Revit.Api
    NuGet packages (https://github.com/Nice3point/RevitTemplates), not a local
    Revit install — this is what makes `dotnet build` work in CI and on any
    machine, Windows or not, without a Revit license. They're the same
    RevitAPI.dll/RevitAPIUI.dll Autodesk ships, just redistributed as
    reference-only NuGet packages versioned to match each Revit release year.

    RevitApiPackageVersion is pinned exactly for 2025 and 2026, not a
    "2025.*"/"2026.*" wildcard — Nice3point publishes a new package patch for
    every Autodesk-issued Revit Update hotfix build (2025.4.0, .20, .41, .50,
    .60 all exist; 2026.4.0, .10 likewise), and each one bakes a different
    RevitAPI/RevitAPIUI assembly version into every Ottawa Tools DLL's own
    reference metadata. Revit's add-in loader does a hard version-equality check
    between that and whatever build is actually installed, logs "Assembly
    version conflict" in the journal on any mismatch, and — confirmed from a
    real customer's journal + crash dump — that mismatch destabilizes the
    session and leads to an unrecoverable crash shortly after, not just a
    benign warning. A floating wildcard silently drifts to whatever hotfix
    Nice3point most recently published, which won't match most customers'
    actually-installed Revit build. 2025.4.0/2026.4.0 are each the base
    Update 4 GA build for their year (assembly version 25.4.0.0 / 26.4.0.0)
    — if a future customer's journal shows "preloaded module of version
    2X.4.Y.0" for some other Y, that's the value to change the matching one
    to.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026'">net48</TargetFramework>

    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2025'">2025.4.0</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2026'">2026.4.0</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026'">$(RevitVersion).*</RevitApiPackageVersion>

    <!--
      A REVIT<year> compile symbol for the rare spot that needs to branch on
      the target API surface directly — e.g. Din276Engine.cs, where Revit
      2026 renamed BuiltInParameter.UNIFORMAT_CODE to ASSEMBLY_CODE (same
      parameter, same underlying id -1002500, confirmed via reflection
      against both years' Nice3point.Revit.Api reference assemblies — a pure
      rename, not a behavior change) with no old-name alias kept, so that one
      call site can't compile unconditionally against both 2025 and 2026 at
      once. Both years otherwise share the same TargetFramework
      (net8.0-windows), so there's no TFM-based #if to piggyback on instead.
    -->
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    UseWindowsForms=true makes the SDK implicitly add System.Drawing and
    System.Windows.Forms as global usings project-wide (every file, whether
    or not it says so), which collides with several Autodesk.Revit.DB/UI
    type names of the same name. Rather than fully-qualifying every call
    site across 65 plugins, these project-wide aliases resolve the bare name
    to whichever meaning this codebase actually uses almost everywhere
    (TaskDialog.Show, a Form subclass, a Revit Color override, a Revit View).
    The handful of call sites that need the other meaning instead (e.g.
    ListView.View, a WinForms Label.ForeColor) already fully-qualify those
    explicitly, which still works fine alongside an alias.
  -->
  <ItemGroup>
    <Using Include="Autodesk.Revit.UI.TaskDialog" Alias="TaskDialog" />
    <Using Include="System.Windows.Forms.Form" Alias="Form" />
    <Using Include="Autodesk.Revit.DB.Color" Alias="Color" />
    <Using Include="Autodesk.Revit.DB.View" Alias="View" />
    <!-- OttawaWork.Shared.FilterRule (our own rule-builder type) collides with Revit's own FilterRule. -->
    <Using Include="OttawaWork.Shared.FilterRule" Alias="FilterRule" />
  </ItemGroup>
</Project>
