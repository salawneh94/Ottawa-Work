<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BIMFlow.Shared</RootNamespace>
    <AssemblyName>BIMFlow.Shared</AssemblyName>
    <!--
      BimFlowUi.cs (the shared dark design system) is WPF. Enabled here
      rather than in Directory.Build.props for the same reason as
      BIMFlow.Dashboard: WinForms/WPF share many bare type names (Button,
      Label, ...), so turning this on for every plugin project would make
      those ambiguous across each plugin's existing WinForms dialogs.
      Referencing this project does NOT force WPF ambiguity onto a
      consumer — that only happens if the consumer's own file also adds
      `using System.Windows.Controls;` etc. alongside `using
      System.Windows.Forms;`, which no existing plugin file does.
    -->
    <UseWPF>true</UseWPF>
    <!--
      SDK-style class libraries do NOT copy their PackageReference runtime
      DLLs to their own bin/ output by default — that only happens
      automatically for executables (verified directly: a plain classlib
      referencing ClosedXML builds clean but leaves bin/ with only its own
      DLL; a second library ProjectReference-ing it doesn't get ClosedXML
      either). Every BIMFlow project, including this one, is a class
      library (Revit loads add-ins as DLLs, nothing here is OutputType=Exe),
      so without this, ClosedXML.dll and its own dependencies
      (ClosedXML.Parser, DocumentFormat.OpenXml[.Framework],
      ExcelNumberFormat, RBush, SixLabors.Fonts, System.IO.Packaging) never
      land in ANY bin/ folder at all — not here, not in any plugin that
      references this project. The CI packaging step's glob filter looked
      like the bug (see its own comment) but broadening it changed nothing,
      because there was nothing of the sort to find in any project's output
      yet. This is what actually makes those DLLs exist on disk for the
      packaging step to pick up.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used by BrandedXlsx.cs to write real .xlsx reports (logo, colors,
         banded rows) instead of plain CSV. Pure .NET, no Revit/Windows
         dependency, so it doesn't affect any project's buildability. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships next to BIMFlow.Shared.dll in the packaged add-in folder
         (see .github/workflows/build-plugins.yml), same convention as
         Icons — BrandedXlsx.cs looks it up relative to its own assembly
         location at runtime, not as a build-time embedded resource. -->
    <None Include="Branding\ottawa-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
